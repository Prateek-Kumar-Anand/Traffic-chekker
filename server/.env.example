# Copy to .env for local runs (never commit .env). On a host such as Render, set these
# as environment variables / secrets in its dashboard instead.

# Google Maps Platform key with ONLY "Routes API" enabled for it. Server-side only.
GOOGLE_MAPS_API_KEY=

# Firebase project id (Firebase console > Project settings > General > Project ID).
# The backend only accepts requests that carry a login token issued by this project.
FIREBASE_PROJECT_ID=

# MongoDB Atlas connection string for a user that can only readWrite the one database.
MONGODB_URI=
MONGODB_DB=trafficchecker

# 32+ random characters. Used to hash client IPs before they are stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Exact origin(s) of the website allowed to call the API, comma separated.
# Origin = scheme + host only: no path, no trailing slash. "*" is rejected.
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io

# Number of reverse proxies in front of this server. Render/Fly/Heroku: 1. Direct: 0.
# Too high lets clients fake their IP and skip the rate limit.
TRUST_PROXY_HOPS=1

PORT=8080
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_HOUR=100
# Same limits counted per signed-in account.
USER_RATE_LIMIT_PER_MIN=10
USER_RATE_LIMIT_PER_HOUR=100
# Hard daily cap on Google requests (one check = 1, +6 when the forecast is included).
DAILY_GOOGLE_CALL_LIMIT=1000
CACHE_TTL_SECONDS=120
# Keep true: browsers always send Origin, so calls without it are refused.
REQUIRE_ORIGIN=true
